# Public IPv4 of the VPS (required)
PUBLIC_IP=203.0.113.10

# Shared secret for time-limited TURN credentials (HMAC)
# Generate: openssl rand -hex 32
TURN_SECRET=replace_with_openssl_rand_hex_32

# Realm shown in ICE
TURN_REALM=aksi-turn

# Optional HTTPS host for credential API
TURN_API_HOST=https://api.example.com
