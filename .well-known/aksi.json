{
  "protocol": "AKSI-VAI/1",
  "name": "AKSI Verifiable Intelligence Interface",
  "version": "1.1",
  "repository_role": "primary",
  "repository": "MILANA808/milana808.github.io",
  "public_interface": "https://milana808.github.io/",
  "execution_backend": "https://github.com/MILANA808/Milana-backend",
  "capabilities": [
    "evidence-records",
    "hash-integrity",
    "ed25519-signatures",
    "chain-verification",
    "decision-provenance",
    "policy-bound-actions",
    "discovery-runtime-contracts",
    "counterfactual-simulation"
  ],
  "discovery": {
    "documentation": "/bridge/",
    "javascript": "/bridge/aksi-bridge.js",
    "protocol": "/AKSI-VAI.md",
    "verifier": "/verify/",
    "trace_ledger": "/trace/",
    "trace_protocol": "/trace/AKSI-TRACE-1.md",
    "origin_archive": "/origin-archive/",
    "origin_chronology": "/origin-archive/chronology.json",
    "proof_engine": "/aksi-engine/",
    "context_compiler": "/context-compiler/",
    "counterfactual_lab": "/counterfactual-lab/",
    "counterfactual_protocol": "/counterfactual-lab/PROTOCOL.md"
  },
  "security": {
    "truth_claim": "A signature proves integrity and key association, not factual truth",
    "default_execution": "none",
    "private_keys": "never published"
  },
  "transport": [
    "https",
    "local",
    "self-hosted"
  ],
  "interop": [
    "OpenAI-compatible",
    "MCP",
    "HTTP",
    "browser-local"
  ]
}
