{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://milana808.github.io/schemas/aksi-evidence-lifecycle-v1.schema.json",
  "title": "AKSI Evidence Lifecycle Record v1",
  "description": "Portable, model-neutral record linking context, claims, evidence, hypotheses, tests, decisions, outcomes, and revisions. JSON Schema validates shape; cross-reference and cryptographic checks require a separate verifier.",
  "type": "object",
  "required": [
    "schema_version",
    "record_id",
    "created_at",
    "subject",
    "context",
    "sources",
    "claims",
    "hypotheses",
    "decision",
    "outcomes",
    "revisions"
  ],
  "properties": {
    "schema_version": {
      "const": "AKSI-EVIDENCE-LIFECYCLE/1"
    },
    "record_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "type": "object",
      "required": [
        "type",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "required": [
        "summary",
        "items"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contextItem"
          }
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hypothesis"
      }
    },
    "decision": {
      "$ref": "#/$defs/decision"
    },
    "outcomes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/outcome"
      }
    },
    "revisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/revision"
      }
    },
    "integrity": {
      "$ref": "#/$defs/integrity"
    },
    "extensions": {
      "type": "object",
      "description": "Namespaced extension fields for experimental integrations."
    }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": [
        "unknown",
        "hypothesis",
        "supported",
        "verified",
        "refuted",
        "superseded"
      ]
    },
    "sourceRefArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "contextItem": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "content",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "fact",
            "assumption",
            "constraint",
            "goal",
            "task",
            "source_note",
            "decision"
          ]
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "source_ids": {
          "$ref": "#/$defs/sourceRefArray"
        },
        "valid_until": {
          "type": "string",
          "format": "date"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "uri",
        "source_type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "title": {
          "type": "string"
        },
        "source_type": {
          "type": "string",
          "enum": [
            "web",
            "document",
            "dataset",
            "code",
            "experiment",
            "human_statement",
            "other"
          ]
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": [
        "id",
        "text",
        "status",
        "source_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "source_ids": {
          "$ref": "#/$defs/sourceRefArray"
        },
        "confidence_label": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "not_assessed"
          ]
        },
        "last_reviewed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "hypothesis": {
      "type": "object",
      "required": [
        "id",
        "statement",
        "status",
        "tests"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "tests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/test"
          }
        }
      },
      "additionalProperties": false
    },
    "test": {
      "type": "object",
      "required": [
        "id",
        "description",
        "outcome"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string"
        },
        "expected_observation": {
          "type": "string"
        },
        "observed_result": {
          "type": "string"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "pending",
            "supports",
            "refutes",
            "inconclusive",
            "blocked"
          ]
        },
        "source_ids": {
          "$ref": "#/$defs/sourceRefArray"
        }
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": [
        "question",
        "alternatives",
        "selected_alternative_id"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "alternatives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "rationale": {
                "type": "string"
              },
              "score": {
                "type": "number"
              },
              "assumptions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "selected_alternative_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "policy_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        },
        "decision_maker": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "outcome": {
      "type": "object",
      "required": [
        "id",
        "observed_at",
        "description",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "observed",
            "partially_observed",
            "not_observed",
            "unknown"
          ]
        },
        "expected": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "observed": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "source_ids": {
          "$ref": "#/$defs/sourceRefArray"
        }
      },
      "additionalProperties": false
    },
    "revision": {
      "type": "object",
      "required": [
        "id",
        "revised_at",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revised_at": {
          "type": "string",
          "format": "date-time"
        },
        "field_path": {
          "type": "string"
        },
        "previous_value": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "new_value": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "$ref": "#/$defs/sourceRefArray"
        }
      },
      "additionalProperties": false
    },
    "integrity": {
      "type": "object",
      "required": [
        "algorithm",
        "digest"
      ],
      "properties": {
        "algorithm": {
          "const": "SHA-256"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "canonicalization": {
          "type": "string"
        },
        "signed_by": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
