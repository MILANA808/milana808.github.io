# AKSI Q declarative interface profile v0.4
page "home" {
  state "visitor" = ""
  state "research-open" = 0
  section {
    text "AKSI MATRIX"
    text "Локальная рабочая среда"
    input "Как к тебе обращаться?" state "visitor"
    value "visitor"
    button "Показать исследовательскую лабораторию" action "toggle-research" state "research-open" add 1
    when "research-open" equals 1 {
      text "Исследовательская лаборатория открыта."
    }
  }
}
