# AKSI Q declarative interface profile v0.2
page "home" {
  state "research-open" = 0
  section {
    text "AKSI MATRIX"
    text "Локальная рабочая среда"
    button "Переключить лабораторию" action "toggle-research" state "research-open" add 1
    value "research-open"
  }
  section {
    text "Исследовательская лаборатория"
    button "Открыть лабораторию" action "open-research"
  }
}
