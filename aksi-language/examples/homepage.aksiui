page "home" {
  state "visitor" = ""
  state "researchOpen" = 0
  section {
    text "AKSI MATRIX"
    text "Локальная рабочая среда"
    input "Как к тебе обращаться?" state "visitor"
    value "visitor"
    button "Показать исследовательскую лабораторию" action "toggle-research" state "researchOpen" add 1
    when "researchOpen" equals 1 {
      text "Исследовательская лаборатория открыта."
    }
  }
}
